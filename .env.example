# ShockFlow AI — environment template. Copy to .env and adjust.
# Demo Mode must work with these defaults and WITHOUT any external API keys.

# --- Operating mode: demo_fixture | historical_replay | live | research ---
SHOCKFLOW_MODE=demo_fixture

# --- API bind (loopback by default; set host 0.0.0.0 for LAN / phone viewing) ---
SHOCKFLOW_API_HOST=127.0.0.1
SHOCKFLOW_API_PORT=8000

# --- Live collectors (disabled by default; the news-sync button is user-initiated) ---
ENABLE_GBFS_LIVE=false
ENABLE_GDELT_LIVE=false

# --- Hybrid search backend: local by default; Elasticsearch is optional and degrades if absent ---
ENABLE_ELASTIC=false
ELASTIC_URL=http://localhost:9200

# --- LLM event extraction: mock provider is deterministic and offline ---
LLM_PROVIDER=mock        # "mock" (default, offline) | "anthropic" (Claude) | "openai" (GPT-4o)
# LLM_API_KEY=           # only for LLM_PROVIDER=anthropic; else the SDK reads ANTHROPIC_API_KEY
# LLM_MODEL=claude-opus-4-8   # extraction model for the anthropic provider
# --- OpenAI (GPT-4o) extraction: set provider=openai + a key. pip install -e ".[llm]" ---
# OPENAI_API_KEY=        # for LLM_PROVIDER=openai; the SDK also reads OPENAI_API_KEY directly
# OPENAI_MODEL=gpt-4o    # extraction model for the openai provider (default gpt-4o)

# --- Neo4j graph (optional [graph] extra; set PASSWORD to enable, else offline in-memory) ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
# NEO4J_PASSWORD=            # e.g. shockflow_dev after: docker compose up -d neo4j

# --- Relational store (optional [rdb] extra). SQLite by default; swap for Postgres. ---
# DATABASE_URL=sqlite:///data/processed/shockflow.db
# DATABASE_URL=postgresql+psycopg://shockflow:shockflow@localhost:5432/shockflow

# --- Time zone for local-hour demand aggregation ---
LOCAL_TZ=America/New_York
